# Скопируйте этот файл в .env и заполните своими значениями

# --- Переменные для подключения к PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=your_database


# --- Порты для запуска сервисов ---
PORT_CLICK_GENERATOR=8081
PORT_CLICK_SCENARIO=8082
PORT_CLICK_COUNTER=8080
PORT_CLICK_STORAGE=8084
PORT_CLICK_DASHBOARD=8085

# --- Размер батча для ClickDashboard ---
STATS_BATCH_SIZE=100

# --- Адрес для ClickStorage из которого он запрашивает данные о статусе из ClickCounter---
STATS_SERVICE_URL=http://localhost:8080/stats





# # # # # ClickDashboard
# Порт, на котором слушает ClickDashboard.
PORT_CLICK_DASHBOARD=8085

# URL StorageGateway.
# Локально: http://localhost:8084
# В Docker: http://storage-gateway:8084 (имя сервиса из docker-compose)
STORAGE_GATEWAY_URL=http://localhost:8084

# Таймаут на ОДИН запрос к StorageGateway.
# Формат: Go duration (300ms, 10s, 1m).
STORAGE_GATEWAY_TIMEOUT=10s

# Максимум дней, которое можно запросить у /stats.
# Если клиент просит больше — 400 Bad Request.
MAX_DAYS=30


# # # # # # .env.template для ClickCounter
# HTTP-сервер.
PORT_CLICK_COUNTER=8080

# Kafka.
# GroupID отсутствует намеренно: читаем с начала топика при каждом старте.
KAFKA_BROKERS=localhost:9092,localhost:9093,localhost:9094
KAFKA_TOPIC=clicks

# StorageGateway.
STORAGE_GATEWAY_URL=http://localhost:8084
STORAGE_GATEWAY_TIMEOUT=10s

# Ретраи отправки.
MAX_RETRIES=5
RETRY_DELAY=1m
LONG_RETRY_DELAY=30m
MAX_FLUSH_DURATION=2h

# Scheduler: 00:05 и 01:05 UTC.
SCHEDULER_HOURS=0,1
SCHEDULER_MINUTE=5



#### .env.template для ClickImitator

# Режим: random | scenario
GENERATOR_MODE=random
# или
# GENERATOR_MODE=scenario

## ЗАПУСК
# Режим random
#GGENERATOR_MODE=random go run ./cmd
# Режим scenario
#GENERATOR_MODE=scenario SCENARIO_DIR=cmd/scenarios go run ./cmd


# Kafka.
KAFKA_BROKERS=localhost:9092,localhost:9093,localhost:9094
KAFKA_TOPIC=clicks
KAFKA_PARTITIONS=8
KAFKA_REPLICATION_FACTOR=3

# Retention: сообщения живут 48ч, сегменты ротируются раз в сутки.
# В Kafka параметры задаются в миллисекундах — здесь Go duration,
# конвертация происходит в EnsureTopic.
KAFKA_RETENTION=48h
KAFKA_SEGMENT=24h

# Общие параметры отправки.
MAX_RETRIES=5

# Параметры режима random (игнорируются в scenario).
AUTHOR_ID_START=1
AUTHOR_ID_END=20
READER_ID_START=1
READER_ID_END=1000
MIN_READS=10
MAX_READS=100
DELAY_BETWEEN_READS_SEC=0

# Параметры режима scenario (игнорируются в random).
SCENARIO_DIR=cmd/scenarios
# SCENARIO_FILE=cmd/scenarios/x.scenario   # только этот файл