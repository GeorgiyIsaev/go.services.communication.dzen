# Скопируйте этот файл в .env и заполните своими значениями.

# ============================================================
# ОБЩЕЕ: Kafka и PostgreSQL (одни на все сервисы)
# ============================================================

# --- Kafka (ClickCounter, ClickImitator) ---

KAFKA_BROKERS=localhost:9092,localhost:9093,localhost:9094          # Внешние адреса брокеров — для локального запуска сервисов
KAFKA_BROKERS_INTERNAL=kafka1:19092,kafka2:19093,kafka3:19094       # Внутренние адреса kafka брокеров в compose-сети

# Параметры топика
KAFKA_TOPIC=clicks
KAFKA_PARTITIONS=8
KAFKA_REPLICATION_FACTOR=3
KAFKA_RETENTION_MS=172800000   # 48h
KAFKA_SEGMENT_MS=86400000      # 24h

# --- PostgreSQL (StorageGateway — единственный клиент БД) ---
DB_HOST=localhost
DB_PORT=5434                   # для локального запуска сервиса (внутри контейнера всегда 5432)
DB_HOST_PORT=5434              # проброс порта на хост в compose; совпадает с DB_PORT, чтобы локальный запуск видел БД
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=your_database

# ============================================================
# STORAGE_GATEWAY
# ============================================================

STORAGE_GATEWAY_PORT=8084
STORAGE_GATEWAY_GRPC_PORT=9084
STORAGE_GATEWAY_MIGRATIONS_PATH=file:///app/migrations

# ============================================================
# CLICK_COUNTER (порт 8080)
# ============================================================

CLICK_COUNTER_PORT=8080

# HTTP-таймауты сервера
CLICK_COUNTER_HTTP_READ_HEADER_TIMEOUT=5s
CLICK_COUNTER_HTTP_READ_TIMEOUT=15s
CLICK_COUNTER_HTTP_WRITE_TIMEOUT=15s
CLICK_COUNTER_HTTP_IDLE_TIMEOUT=60s

# Куда отправлять агрегированную статистику
CLICK_COUNTER_STORAGE_GATEWAY_URL=http://localhost:8084
CLICK_COUNTER_STORAGE_GATEWAY_TIMEOUT=10s

# Пауза после ошибки чтения из Kafka (цикл чтения не прерывается)
CLICK_COUNTER_KAFKA_READ_RETRY_DELAY=1s

# Ретраи flush в StorageGateway: паузы по возрастанию (5 попыток за 15 минут).
CLICK_COUNTER_FLUSH_RETRY_DELAYS=1m,2m,4m,8m

# Планировщик: 00:05 и 01:05 UTC
CLICK_COUNTER_SCHEDULER_HOURS=0,1
CLICK_COUNTER_SCHEDULER_MINUTE=5

# ============================================================
# CLICK_DASHBOARD (порт 8085)
# ============================================================

CLICK_DASHBOARD_PORT=8085
CLICK_DASHBOARD_STORAGE_GATEWAY_ADDR=localhost:9084  # gRPC, host:port
CLICK_DASHBOARD_STORAGE_GATEWAY_TIMEOUT=10s
CLICK_DASHBOARD_MAX_DAYS=30
CLICK_DASHBOARD_REFRESH_INTERVAL=5m

# Стартовые ретраи первого Refresh
CLICK_DASHBOARD_STARTUP_RETRY_DELAYS=10s,10s,10s,10s,10s

# ============================================================
# CLICK_IMITATOR (режим random | scenario)
# ============================================================

CLICK_IMITATOR_GENERATOR_MODE=random
# CLICK_IMITATOR_GENERATOR_MODE=scenario
CLICK_IMITATOR_LOG_LEVEL=info

# Ретраи отправки клика в Kafka
CLICK_IMITATOR_SEND_RETRY_DELAYS=500ms,1s,2s,4s
CLICK_IMITATOR_SEND_TIMEOUT=5s

# Параметры режима random (игнорируются в scenario)
CLICK_IMITATOR_AUTHOR_ID_START=1
CLICK_IMITATOR_AUTHOR_ID_END=20
CLICK_IMITATOR_READER_ID_START=1
CLICK_IMITATOR_READER_ID_END=1000
CLICK_IMITATOR_MIN_READS=10
CLICK_IMITATOR_MAX_READS=100
CLICK_IMITATOR_DELAY_BETWEEN_READS_SEC=1

# Параметры режима scenario (игнорируются в random)
CLICK_IMITATOR_SCENARIO_DIR=cmd/scenarios
# CLICK_IMITATOR_SCENARIO_FILE=cmd/scenarios/x.scenario  # (опционально, если нужен только один файл)
