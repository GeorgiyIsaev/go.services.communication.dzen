# Скопируйте этот файл в .env и заполните своими значениями

# ============================================================
# # # ОБЩИЕ НАСТРОЙКИ
# ============================================================

# --- PostgreSQL (ClickStorage) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=your_database

# --- Kafka (ClickCounter, ClickImitator) ---
KAFKA_BROKERS=localhost:9092,localhost:9093,localhost:9094
KAFKA_TOPIC=clicks

# --- StorageGateway (ClickCounter, ClickDashboard) ---
STORAGE_GATEWAY_URL=http://localhost:8084
STORAGE_GATEWAY_TIMEOUT=10s

# --- Общие ретраи (ClickCounter, ClickImitator) ---
MAX_RETRIES=5
SEND_TIMEOUT=5s

# ============================================================
# # #  (StorageGateway, порт 8084)
# ============================================================
PORT_CLICK_STORAGE=8084
STATS_BATCH_SIZE=100
STATS_SERVICE_URL=http://localhost:8080/stats

# ============================================================
# # # ClickCounter (порт 8080)
# ============================================================
PORT_CLICK_COUNTER=8080

# Ретраи отправки в StorageGateway (специфичны для ClickCounter)
RETRY_DELAY=1m
LONG_RETRY_DELAY=30m
MAX_FLUSH_DURATION=2h

# Планировщик: 00:05 и 01:05 UTC
SCHEDULER_HOURS=0,1
SCHEDULER_MINUTE=5

# ============================================================
# # # ClickDashboard (порт 8085)
# ============================================================

STORAGE_GATEWAY_ADDR=localhost:8084
STORAGE_GATEWAY_TIMEOUT=10s
MAX_DAYS=30
REFRESH_INTERVAL=5m

# ============================================================
# # # ClickImitator (режим random | scenario)
# ============================================================
GENERATOR_MODE=random
#GENERATOR_MODE=scenario

# Настройки Kafka-топика (создаются при старте)
KAFKA_PARTITIONS=8
KAFKA_REPLICATION_FACTOR=3
KAFKA_RETENTION=48h
KAFKA_SEGMENT=24h

# Параметры режима random (игнорируются в scenario)
AUTHOR_ID_START=1
AUTHOR_ID_END=20
READER_ID_START=1
READER_ID_END=1000
MIN_READS=10
MAX_READS=100
DELAY_BETWEEN_READS_SEC=0

# Параметры режима scenario (игнорируются в random)
SCENARIO_DIR=cmd/scenarios
# SCENARIO_FILE=cmd/scenarios/x.scenario  # (опционально, если нужен только один файл)
